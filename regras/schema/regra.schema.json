{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "critiquesites/regra.schema.json",
  "title": "Regra do critiquesites (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "categoria",
    "titulo",
    "descricao",
    "deteccao",
    "peso",
    "severidade",
    "selo",
    "confianca",
    "tipos_de_site",
    "modo",
    "correcao",
    "prompt_correcao",
    "fonte",
    "origem_ids",
    "citacoes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "categoria": {
      "type": "string",
      "enum": [
        "visual-cor",
        "visual-tipografia",
        "visual-superficie",
        "visual-iconografia",
        "visual-movimento",
        "layout-espacamento",
        "estrutura-padrao",
        "texto-generico",
        "conteudo-confianca",
        "ux-heuristica",
        "interacao-estados",
        "responsividade",
        "acessibilidade",
        "performance",
        "seo",
        "ia-visibilidade",
        "lei-br",
        "integridade",
        "seguranca-conteudo",
        "seo-google"
      ]
    },
    "subcategoria": {
      "type": "string"
    },
    "titulo": {
      "type": "string",
      "minLength": 3,
      "maxLength": 90
    },
    "descricao": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "deteccao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo",
        "medidor",
        "metodo",
        "detectavel_por_script"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "script",
            "julgamento",
            "misto"
          ]
        },
        "medidor": {
          "type": "string",
          "enum": [
            "html",
            "css",
            "js",
            "jsonld",
            "axe",
            "lighthouse",
            "links",
            "imagens",
            "seo",
            "robots",
            "lei",
            "texto",
            "secoes",
            "ia-visibilidade",
            "injecao",
            "integridade",
            "modelo",
            "seo-google"
          ]
        },
        "metodo": {
          "type": "string",
          "minLength": 15
        },
        "detectavel_por_script": {
          "type": "string",
          "enum": [
            "sim",
            "nao",
            "parcial"
          ]
        },
        "parametros": {
          "type": "object"
        }
      }
    },
    "peso": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "severidade": {
      "type": "string",
      "enum": [
        "tell",
        "smell",
        "info",
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "selo": {
      "type": "string",
      "enum": [
        "fato",
        "regra",
        "opiniao",
        "nao-verificavel"
      ]
    },
    "confianca": {
      "type": "string",
      "enum": [
        "alta",
        "media",
        "baixa"
      ]
    },
    "tipos_de_site": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "*",
          "site-institucional",
          "landing-page",
          "blog",
          "catalogo",
          "loja",
          "cardapio",
          "agendamento",
          "pagina-de-vendas",
          "portfolio",
          "link-na-bio",
          "area-de-membros"
        ]
      }
    },
    "modo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "rapido",
          "completo"
        ]
      }
    },
    "correcao": {
      "type": "string",
      "minLength": 15
    },
    "prompt_correcao": {
      "type": "string",
      "minLength": 30
    },
    "fonte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nome",
          "licenca"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 2
          },
          "url": {
            "type": "string"
          },
          "licenca": {
            "type": "string"
          },
          "data_consulta": {
            "type": "string"
          }
        }
      }
    },
    "origem_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citacoes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "numero",
          "trecho",
          "contagem"
        ]
      }
    },
    "notas": {
      "type": "string"
    }
  }
}
