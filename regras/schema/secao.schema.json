{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "critiquesites/secao.schema.json",
  "title": "Seções esperadas por tipo de site (v1)",
  "description": "Um arquivo regras/secoes/<tipo>.json é um ARRAY de seções esperadas. Sem fonte com url não há regra.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/secao" },
  "definitions": {
    "secao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tipo_de_site", "nome", "descricao", "obrigatoriedade", "peso", "deteccao", "fonte", "confianca", "notas"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
        "tipo_de_site": {
          "type": "string",
          "enum": ["site-institucional", "landing-page", "blog", "catalogo", "loja", "cardapio", "agendamento", "pagina-de-vendas", "portfolio", "link-na-bio", "area-de-membros"]
        },
        "nome": { "type": "string", "minLength": 3, "maxLength": 90 },
        "descricao": { "type": "string", "minLength": 20, "maxLength": 400, "description": "PT-BR simples: o que o visitante espera ali e por quê." },
        "obrigatoriedade": { "type": "string", "enum": ["essencial", "esperada", "opcional"] },
        "peso": { "type": "number", "minimum": 0, "maximum": 10 },
        "deteccao": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seletores", "palavras", "padroes_regex", "onde", "detectavel_por_script"],
          "properties": {
            "seletores": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Seletores CSS." },
            "palavras": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "PT-BR, minúsculas; variante sem acento é opcional." },
            "padroes_regex": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "description": "Expressões regulares JavaScript (sem barras)." },
            "onde": { "type": "string", "enum": ["home", "qualquer-pagina", "pagina-propria"] },
            "detectavel_por_script": { "type": "string", "enum": ["sim", "nao", "parcial"] }
          }
        },
        "fonte": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nome", "url", "licenca", "data_consulta"],
            "properties": {
              "nome": { "type": "string", "minLength": 2 },
              "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
              "licenca": { "type": "string", "minLength": 2 },
              "data_consulta": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        },
        "confianca": { "type": "string", "enum": ["alta", "media", "baixa"] },
        "notas": { "type": "string" }
      }
    }
  }
}
